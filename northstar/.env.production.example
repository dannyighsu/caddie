# Northstar Production Environment (Vercel)
# These values are set in Vercel project settings or auto-injected by linked stores

# Application
NODE_ENV=production
BASE_URL=https://your-app.vercel.app

# Database - Vercel Postgres (Neon)
# POSTGRES_URL is auto-injected when you link a Vercel Postgres store
POSTGRES_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (Vercel KV)
# Auto-injected when you link a Vercel KV store
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# OAuth - Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# OAuth - Notion
NOTION_INTERNAL_TOKEN=...
NOTION_REDIRECT_URI=https://your-app.vercel.app/api/auth/notion/callback

# Slack (OAuth is handled by ChatKit - use ChatKit portal to connect Slack)
SLACK_APP_ID=your_slack_app_id

# Porter/ChatKit
CHATKIT_BASE_URL=https://your-chatkit-server/api/chat
CHATKIT_SECRET=your_chatkit_secret
ADMIN_TOKEN_KEY=your_admin_token_key
JWT_SECRET_KEY=your_jwt_secret_key

# ConstellationFS (Remote SSH)
CONSTELLATION_WORKSPACE_ROOT=/workspaces
CONSTELLATION_HOST=your-vm.example.com
CONSTELLATION_SSH_PASSWORD=your_ssh_password
CONSTELLATION_MCP_TOKEN=your_mcp_token
CONSTELLATION_WORKSPACE=default
