# =============================================================================
# Portal environment — copy to .env.local and fill in.
#
#   cp northstar/.env.example northstar/.env.local
#
# Three sections:
#   1. REQUIRED   — nothing works until these are set.
#   2. DEFAULTED  — every one has a working fallback in code. Left commented,
#                   showing the actual default. Uncomment only to change it.
#   3. OPTIONAL   — features that stay off until configured. Skipping one costs
#                   you that feature and nothing else.
#
# Anything not listed here is injected by the harness at run time
# (HARNESS_ROOT, NORTHSTAR_AGENT_ID, NORTHSTAR_TRACE_ID, ...) — never set by hand.
# Those still carry the deprecated "Northstar" prefix; they're internal, so
# renaming them is a separate cleanup from the user-facing PORTAL_URL.
# =============================================================================


# =============================================================================
# 1. REQUIRED
# =============================================================================

# --- Datastores -------------------------------------------------------------
# Postgres holds conversations, settings, and the job-run ledger.
# getPool() throws without this — every API route that touches state fails.
POSTGRES_URL=postgresql://user:password@localhost:5432/buri

# Redis holds the schedule queue and the active-run locks. The scheduler starts
# at boot and polls every 30s, so a missing URL means recurring jobs never fire.
REDIS_URL=redis://localhost:6379


# --- Team roster ------------------------------------------------------------
# Who the agent trusts. An inbound sender whose email / Slack id / Telegram id
# isn't on this roster resolves to `guest`, and the guest tier is granted
# nothing — no capabilities and no built-in tools. So with an empty roster the
# agent boots and then can't do anything for anyone.
#
# Members live in lettered slots. Two is what this install needs; adding a third
# means adding "C" to SLOTS in harness/src/team/roster.ts and a block here.
# The FIRST configured slot is the owner: portal runs are attributed to them and
# failure alerts go to their address.
#
#   _NAME         Display name — how the agent refers to them. Required; a slot
#                 without one is treated as unused.
#   _EMAIL        Comma-separated. The first is primary and is the address used
#                 to invite them to calendar events.
#   _SLACK_ID     Optional; needed for Slack senders to be recognized as team.
#   _TELEGRAM_ID  Optional; same for Telegram.
#   _ID           Optional stable id. Defaults to a slug of the name — set it
#                 explicitly if you rename someone and want their existing
#                 conversation history to keep matching.
TEAM_MEMBER_A_NAME=Your Name
TEAM_MEMBER_A_EMAIL=you@example.com,you@work.example.com
# TEAM_MEMBER_A_SLACK_ID=U01234567
# TEAM_MEMBER_A_TELEGRAM_ID=123456789
# TEAM_MEMBER_A_ID=

# Second member. Delete this block if the instance serves one person.
# TEAM_MEMBER_B_NAME=Their Name
# TEAM_MEMBER_B_EMAIL=them@example.com
# TEAM_MEMBER_B_SLACK_ID=U89ABCDEF
# TEAM_MEMBER_B_TELEGRAM_ID=987654321


# --- Google (Calendar + Gmail) ----------------------------------------------
# Gmail is the agent's inbox: it drives the inbound email channel and the
# `reply` / `send_email` / `email_team` tools, plus calendar read/write.
# Skip only if you're running portal-only with no email and no calendar.
#
# Enable the Calendar and Gmail APIs, create OAuth credentials at
# https://console.cloud.google.com/apis/credentials (Desktop app) with
# http://localhost:3456/oauth2callback as an authorized redirect URI, then
# authorize once with:  make google-auth
# Tokens are written to harness/credentials/ and are gitignored.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Google Sheets/Docs/Slides (optional). The account the agent's `gog` CLI acts as — the
# same address you passed to `make gog-auth ACCOUNT=...`. See README step 3.
# GOG_ACCOUNT=agent@example.com


# =============================================================================
# 2. DEFAULTED — working fallbacks; uncomment only to override
# =============================================================================

# --- Agent runtime ----------------------------------------------------------
# Which engine executes a run. Only "claude-code" is implemented.
# AGENT_RUNTIME=claude-code

# Path to the Claude Code CLI. Resolved from PATH by default.
# CLAUDE_BINARY=claude

# Model and reasoning effort for every agent run.
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_EFFORT=medium

# Which agent handles inbound messages and owns outbound threads. With exactly
# one agent directory this resolves on its own; set it only if you ever add a
# second, at which point resolution refuses to guess and throws.
# DEFAULT_AGENT_ID=buri

# Where agent working directories live. The Makefile passes this explicitly, so
# setting it here only affects processes started outside `make`.
# WORKSPACE_ROOT=<repo>/workspace


# --- Internal URLs ----------------------------------------------------------
# Where this portal is reachable. Used by the agent's MCP tools to call the
# control API, by the lifecycle hooks that stream traces, and as the base for
# transcript links in failure-alert emails. Set it if you move off port 3000.
# PORTAL_URL=http://localhost:3000

# OAuth callback used when refreshing tokens at run time. NOTE: the one-time
# consent flow (`make google-auth`) listens on port 3456 instead, so the URI you
# register in Google Cloud is http://localhost:3456/oauth2callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Where the shared Google token file is written by `make google-auth`.
# GOOGLE_TOKENS_FILE=<repo>/harness/credentials/google-calendar-tokens.json


# --- Gmail polling ----------------------------------------------------------
# The agent's own address. Read from the authorized account's profile if unset.
# GMAIL_ADDRESS=agent@example.com

# How often the inbound poller checks for unread mail, in milliseconds.
# GMAIL_POLL_INTERVAL_MS=60000


# =============================================================================
# 3. OPTIONAL — each block is a feature that stays off until configured
# =============================================================================

# --- Notion -----------------------------------------------------------------
# Grants the `notion` capability. Create an internal integration at
# https://www.notion.so/profile/integrations and share the pages you want
# reachable with it.
# Referenced from harness/capabilities/notion.json, not from application code.
# NOTION_INTERNAL_TOKEN=ntn_...


# --- Slack ------------------------------------------------------------------
# Connects over Socket Mode — an outbound WebSocket, so no public URL needed.
# Both tokens are required together; with neither, the Slack channel is simply
# absent. Enable Socket Mode, generate an app-level token, and subscribe to
# `message.im` and `app_mention`.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
#
# Per-member Slack ids live on the roster above (TEAM_MEMBER_*_SLACK_ID).
# Without them, every Slack sender is a guest.


# --- Telegram ---------------------------------------------------------------
# Webhook-based, so it needs PUBLIC_URL below to be reachable from Telegram.
# See docs/TELEGRAM.md. Entirely optional — the agent runs fine without it.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=your_bot
#
# Shared secret Telegram echoes back on each webhook call, so the endpoint can
# reject forged requests. Strongly recommended whenever Telegram is on.
# TELEGRAM_WEBHOOK_SECRET=
#
# Comma-separated chat ids the bot will respond in. Unset means no allowlist.
# TELEGRAM_ALLOWED_CHATS=
#
# Per-member Telegram ids live on the roster above (TEAM_MEMBER_*_TELEGRAM_ID).


# --- Public exposure --------------------------------------------------------
# Set only if this instance is reachable from the internet (Tailscale Funnel,
# ngrok). PUBLIC_URL turns on the middleware host gate: on that host every route
# 404s except the webhook endpoints. Leave unset for localhost/tailnet-only,
# which is the default posture — see the "Network exposure" section in README.
# PUBLIC_URL=https://your-node.ts.net
#
# Password for the /public/* pages. Those pages are unreachable without it.
# PUBLIC_PAGE_PASSWORD=


# --- Observability ----------------------------------------------------------
# Langfuse tracing. All three are needed together; tracing is a no-op otherwise.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com


# =============================================================================
# NO LONGER USED — delete these if you're migrating an older .env.local
# =============================================================================
#   AGENTMAIL_API_KEY, AGENTMAIL_INBOX_ID, AGENTMAIL_SIGNING_SECRET, EMAIL_FROM
#       Email moved from AgentMail to Gmail.
#   RESEND_API_KEY, RESEND_WEBHOOK_SECRET
#       Superseded by the same migration.
#   WHATSAPP_ACCESS_TOKEN
#       No WhatsApp channel exists.
#   OPENROUTER_API_KEY
#       Powered the message classifier, which was removed when multi-agent
#       routing collapsed into profiles of a single base agent.
