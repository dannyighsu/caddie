{
  "name": "google-calendar",
  "description": "Google Calendar read/write access via MCP",
  "trust": "household",
  "server": {
    "command": "node",
    "args": ["../mcp-servers/google-calendar.mjs"],
    "env": {
      "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
      "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}"
    }
  }
}
