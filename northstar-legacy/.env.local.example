# Northstar Local Development Environment
# Copy this file to .env.local and fill in your values

# Application
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database - Local PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/northstar

# Upstash Redis (Vercel KV) - Create a free instance at https://console.upstash.com
# Free tier: 10K commands/day, 256MB storage
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# OAuth - Google Calendar
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OAuth - Notion
# Create at: https://www.notion.so/my-integrations
NOTION_INTERNAL_TOKEN=...
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# Slack (OAuth is handled by ChatKit - use ChatKit portal to connect Slack)
SLACK_APP_ID=your_slack_app_id

# Porter/ChatKit
CHATKIT_BASE_URL=http://localhost:8080/api/chat
CHATKIT_SECRET=...
ADMIN_TOKEN_KEY=your_admin_token_key
JWT_SECRET_KEY=your_jwt_secret_key

# ConstellationFS
CONSTELLATION_WORKSPACE_ROOT=/path/to/your/workspace/root
CONSTELLATION_HOST=localhost
CONSTELLATION_SSH_PASSWORD=...
CONSTELLATION_MCP_TOKEN=...
CONSTELLATION_WORKSPACE=default
