####################
harness/.browser-profile/
harness/.agent-venv/

# Project specific #
####################
.ipynb_checkpoints
.build
logs/*
celerybeat-schedule.db
operations
public/sandpack

# Service specific node_modules
**/vite-renderer-service/node_modules
**/node-renderer-service/node_modules

# Test outputs
**/tests/output

# Application specific
village_docs_internal.html
village_docs.html
Secrets.swift
.coverage
.ruff_cache
.aider*
.DS_Store
.workspace
# Snapshots of the agent's durable memory, written by the harness on every run.
# They are copies of one install's config — standing instructions, member
# profiles — so they belong to the install and not the repo, same as the config
# they back up. The README is kept so a fresh clone still explains the directory.
harness/agent/config-history/*
!harness/agent/config-history/README.md
# Who this install's agent is and whom it serves. PERSONA.example.md is the
# committed template.
harness/agent/PERSONA.md
workspace/

# Eval runs: per-run sandboxes and results (transcripts quote real prompts).
evals/.sandbox/
evals/results/
evals/.scrub.json
