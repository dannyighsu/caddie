# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.xcuserstate
xcschememanagement.plist

# Environment files #
######################
# Catch-all, so backups and one-off variants (.env.local.bak-*, .env.staging)
# can never be committed. The template is the single deliberate exception.
.env*
!.env.example

