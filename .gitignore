# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.xcuserstate
xcschememanagement.plist

# Environment files #
######################
# Catch-all, so backups and one-off variants (.env.local.bak-*, .env.staging)
# can never be committed. The template is the single deliberate exception.
.env*
!.env.example

# Python #
##########
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node.js #
###########
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Frontend build artifacts #
############################
dist/
build/
coverage/
.next/
out/
temp/
*.tsbuildinfo

# IDE and editors #
###################
.idea/
.vscode/
*.swp
*.swo

# Browser profiles #
####################
harness/.browser-profile/

# Project specific #
####################
.ipynb_checkpoints
.build
logs/*
celerybeat-schedule.db
operations
public/sandpack

# Service specific node_modules
**/vite-renderer-service/node_modules
**/node-renderer-service/node_modules

# Test outputs
**/tests/output

# Application specific
village_docs_internal.html
village_docs.html
Secrets.swift
.coverage
.ruff_cache
.aider*
.DS_Store
.workspace
# Recurring job definitions are per-instance: a job names real places, people,
# and criteria for one household, so it belongs to that install and not the
# repo. The README is kept so a fresh clone still explains what goes here.
harness/agents/*/jobs/*
!harness/agents/*/jobs/README.md
workspace/
